# Environment variables example for QuantumLogics Pilot
# ---------------------------------------------------
# Frontend configuration
# The port on which the React development server runs.
# The default is 3000, but the application can fall back to other ports
# if this one is unavailable (see server code for dynamic fallback).
FRONTEND_PORT=3000

# Backend configuration
# The port on which the Express server runs.
# The default is 5000, but the server will try alternative ports if needed.
BACKEND_PORT=5000

# CORS configuration
# The origin allowed to access the backend API. It should match the frontend URL.
# Example: http://localhost:${FRONTEND_PORT}
# Adjust if you serve the frontend from a different host or port.
CORS_ORIGIN=http://localhost:${FRONTEND_PORT}

# Additional environment variables can be added as needed.
